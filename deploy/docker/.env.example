# Sanitized template only. Do not commit active credentials or secrets.

# Exact release identity. Production must use an approved tag-and-digest value.
GOREECLOUD_BACKUP_IMAGE=REPLACE_WITH_APPROVED_IMAGE:REPLACE_WITH_VERSION@sha256:REPLACE_WITH_DIGEST

# Choose these only after fresh live permission/readability validation.
GOREECLOUD_BACKUP_UID=REPLACE_WITH_VALIDATED_UID
GOREECLOUD_BACKUP_GID=REPLACE_WITH_VALIDATED_GID

# During the first controlled replacement, these may intentionally retain the
# existing Kopia host paths if that is the safest rollback-compatible state.
# Do not rename or copy them merely for cosmetic consistency.
GOREECLOUD_BACKUP_CONFIG_DIR=REPLACE_WITH_VERIFIED_CONFIG_DIR
GOREECLOUD_BACKUP_CACHE_DIR=REPLACE_WITH_VERIFIED_CACHE_DIR
GOREECLOUD_BACKUP_LOG_DIR=REPLACE_WITH_VERIFIED_LOG_DIR
GOREECLOUD_BACKUP_TMP_DIR=REPLACE_WITH_VERIFIED_TMP_DIR
GOREECLOUD_BACKUP_RESTORE_DIR=REPLACE_WITH_VERIFIED_RESTORE_TEST_DIR

# Preserve the verified repository access path during the initial replacement.
GOREECLOUD_BACKUP_SFTP_KEY_FILE=REPLACE_WITH_VERIFIED_SFTP_KEY_FILE
GOREECLOUD_BACKUP_SFTP_KNOWN_HOSTS_FILE=REPLACE_WITH_VERIFIED_KNOWN_HOSTS_FILE

# Password content stays in this protected host file and is injected as a
# Compose secret. Do not put the password itself in this environment file.
GOREECLOUD_BACKUP_REPOSITORY_PASSWORD_FILE=REPLACE_WITH_PROTECTED_REPOSITORY_PASSWORD_FILE

TZ=REPLACE_WITH_VERIFIED_VPS_TIMEZONE
