# Sanitized template only. Do not commit active credentials or secrets.

# Exact release identity. Production must use an approved tag-and-digest value.
GOREECLOUD_BACKUP_IMAGE=REPLACE_WITH_APPROVED_IMAGE:REPLACE_WITH_VERSION@sha256:REPLACE_WITH_DIGEST

# Select these only after verifying host ownership and source-read requirements.
GOREECLOUD_BACKUP_UID=REPLACE_WITH_VALIDATED_UID
GOREECLOUD_BACKUP_GID=REPLACE_WITH_VALIDATED_GID

# GoreeCloud VPS persistent paths.
GOREECLOUD_BACKUP_CONFIG_DIR=/srv/docker/appdata/goreecloud-backup/config
GOREECLOUD_BACKUP_CACHE_DIR=/srv/docker/appdata/goreecloud-backup/cache
GOREECLOUD_BACKUP_LOG_DIR=/srv/docker/logs/goreecloud-backup
GOREECLOUD_BACKUP_RESTORE_DIR=/srv/docker/appdata/goreecloud-backup/restore-tests

# Deliberately explicit source scope. Expanding this to / requires a documented
# least-privilege justification and live host-permission review.
GOREECLOUD_BACKUP_SOURCE_ROOT=/srv/docker

# No public host port is published. Verify the live private proxy network.
GOREECLOUD_GATEWAY_NETWORK=REPLACE_WITH_VERIFIED_GATEWAY_NETWORK

GOREECLOUD_BACKUP_SERVER_USERNAME=goreecloud-backup-admin
GOREECLOUD_BACKUP_SERVER_CONTROL_USERNAME=server-control
TZ=UTC

# Protected host files. Values are read through Compose secrets and are not
# stored in this environment file.
GOREECLOUD_BACKUP_REPOSITORY_PASSWORD_FILE=/srv/docker/secrets/goreecloud-backup/repository-password
GOREECLOUD_BACKUP_SERVER_PASSWORD_FILE=/srv/docker/secrets/goreecloud-backup/server-password
GOREECLOUD_BACKUP_SERVER_CONTROL_PASSWORD_FILE=/srv/docker/secrets/goreecloud-backup/server-control-password
